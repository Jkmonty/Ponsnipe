# ─────────────────────────────────────────────────────────────────────────────
# Robinhood Chain
# ─────────────────────────────────────────────────────────────────────────────
# Public RPC works but is rate-limited. For real use, put an Alchemy / private
# RPC URL here.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663

# Optional WebSocket endpoint (Alchemy/QuickNode give you one alongside HTTPS).
# When set, the monitor and sniper switch from polling to eth_subscribe: new
# blocks and trades on your tokens are PUSHED, which takes the polling interval
# out of exit latency entirely. Strongly recommended before trading real size.
# WSS_URL=wss://robinhood-mainnet.g.alchemy.com/v2/your-key

# NOTE: the backtest deliberately does NOT use RPC_URL — bulk history needs wide
# eth_getLogs ranges and provider free tiers cap them hard (Alchemy free = 10
# blocks). It uses the public endpoint, which allows 2000. Override with
# BACKTEST_RPC_URL only if you have a paid plan.

# ─────────────────────────────────────────────────────────────────────────────
# Bot wallet
# ─────────────────────────────────────────────────────────────────────────────
# Passphrase used to encrypt/decrypt data/bot.keystore.json (AES-256-GCM).
# Generate a strong random value. If you lose this you lose access to the wallet.
KEYSTORE_PASSPHRASE=change-me-to-a-long-random-string

# Path to the encrypted keystore file (created by `npm run wallet:init`).
KEYSTORE_PATH=./data/bot.keystore.json

# ─────────────────────────────────────────────────────────────────────────────
# Engine
# ─────────────────────────────────────────────────────────────────────────────
# The monitor is event-driven (reacts to new blocks + trades on your token's
# curve). These are the knobs:
#   POLLING_INTERVAL_MS  - how often viem asks the RPC for new blocks / logs.
#                          This is your real reaction cadence. 400ms is fine for
#                          a private RPC; the public RPC only refreshes every
#                          ~2-3s so lower values just waste calls there.
#   MONITOR_HEARTBEAT_MS  - safety-net full re-check, always runs at least this often.
POLLING_INTERVAL_MS=400
MONITOR_HEARTBEAT_MS=4000

# Priority-fee multiplier for auto-sell transactions, so they land first in the
# next block (1.3 = +30% tip vs the estimate). 1 disables the bump.
SELL_GAS_MULTIPLIER=1.3

# Set to "1" to actually broadcast sell transactions. When unset/0 the monitor
# logs what it *would* do but never sends a tx. Start in dry-run.
ENGINE_LIVE=0

# Default slippage tolerance for buys and auto-executed sells, in basis points
# (300 = 3%). Bonding-curve trades near launch can need more.
DEFAULT_SLIPPAGE_BPS=300

# SQLite database path.
DATABASE_PATH=./data/positions.sqlite

# Shared secret required by state-changing API routes (open/close positions).
# Any random string; the web UI reads it from this same env at build/runtime.
ENGINE_API_TOKEN=change-me-too

# Optional: push new pons launches over Bitquery's WebSocket instead of waiting
# for the polling sweep. Runs alongside it, never instead of it, so an expired
# token or a dropped socket costs latency and nothing else.
# Get one at https://account.bitquery.io/user/api_v2/access_tokens
BITQUERY_TOKEN=
