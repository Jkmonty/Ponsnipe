{
  "name": "pons-autotrade",
  "version": "0.1.0",
  "private": true,
  "description": "Buy pons.family memecoins on Robinhood Chain with automatic take-profit / stop-loss exits.",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "setup": "tsx scripts/setup.ts",
    "wallet:init": "tsx scripts/wallet-init.ts",
    "smoke": "tsx scripts/smoke.ts",
    "backtest": "tsx scripts/backtest.ts",
    "scan": "tsx scripts/scan.ts",
    "analyse": "tsx scripts/analyse.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "migration": "tsx scripts/migration.ts"
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.5.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
